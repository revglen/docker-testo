FROM gcr.io/distroless/python3-debian12:nonroot
WORKDIR /app
COPY --from=fastapi-builder /app/packages /app/packages

COPY src/env_vars/* .

ENV PYTHONPATH=/app/packages

EXPOSE 5000

ENTRYPOINT ["/usr/bin/python3.11", "-m", "uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "5000"]

